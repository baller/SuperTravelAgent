APP_ENV=development
WEB_ORIGIN=http://localhost:8080

POSTGRES_DB=supertravel
POSTGRES_USER=supertravel
POSTGRES_PASSWORD=supertravel
DATABASE_URL=postgresql+asyncpg://supertravel:supertravel@postgres:5432/supertravel
CHECKPOINT_DATABASE_URL=postgresql://supertravel:supertravel@postgres:5432/supertravel
REDIS_URL=redis://redis:6379/0

# OpenAI-compatible model provider
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_THINKING_ENABLED=true
LLM_REASONING_EFFORT=high
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=8192
LLM_STRUCTURED_RETRIES=1
MAX_AGENT_ITERATIONS=12
MAX_AGENT_RUN_SECONDS=240

# 可选网页研究。未配置时 Agent 会使用地图、12306 和小红书等已启用工具，
# 但不会伪造网络搜索结果。
SERPER_API_KEY=
SERPER_API_URL=https://google.serper.dev/search
WEB_FETCH_MAX_BYTES=1000000

# 百度地图服务端 AK 仅供 MCP 调用地点、路线和天气；基础底图不依赖百度 JS API
BAIDU_MAP_SERVER_AK=
# 个人开发者常用服务并发上限为 3 QPS；MVP 默认留出余量。
BAIDU_MAP_MAX_QPS=2

# Community 12306 MCP is read-only: search, filtering, route stations and transfers.
ENABLE_12306_MCP=true
RAIL_MCP_URL=http://mcp-12306:8000/mcp
BAIDU_MAP_MCP_URL=http://mcp-baidu:8100/mcp

# Optional read-only Xiaohongshu research. Obtain your own browser session cookie
# and keep it only in the ignored .env file. The product never exposes it to traces.
ENABLE_XHS_MCP=false
XHS_MCP_URL=http://mcp-xhs:8200/mcp
XHS_COOKIE=
WEB_PORT=8080
TOOL_TIMEOUT_SECONDS=25
TOOL_RESULT_MAX_BYTES=2000000
DNS_PRIMARY=223.5.5.5
DNS_SECONDARY=8.8.8.8
# Docker Desktop behind a local proxy: http://host.docker.internal:<port>
# Leave blank when containers can access model providers directly.
CONTAINER_HTTP_PROXY=
